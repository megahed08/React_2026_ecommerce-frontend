VITE_SITE_NAME=Shop
VITE_SITE_SHORT_NAME=Shop
VITE_SITE_DESCRIPTION="Modern React storefront demo with customer checkout and product administration."
VITE_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=/api

VITE_LOGO_PATH=/brand/logo.svg
VITE_FAVICON_PATH=/brand/favicon.svg

VITE_SOCIAL_LINKS_TWITTER=
VITE_SOCIAL_LINKS_FACEBOOK=
VITE_SOCIAL_LINKS_INSTAGRAM=

VITE_CONTACT_EMAIL=support@shop.demo

# Public frontend-demo credentials.
# These values are not secrets because Vite embeds them
# into the generated browser bundle.
VITE_DEMO_ADMIN_EMAIL=admin@shop.demo
VITE_DEMO_ADMIN_PASSWORD="Admin123!"